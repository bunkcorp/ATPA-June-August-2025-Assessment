confusionMatrix(pred.xgb.class, as.factor(data.test$wage_flag), positive = "1")
pred.xgb.prob <- predict(xgb.tuned, newdata = data.test, type = "prob")[, 2]
roc(as.numeric(data.test$wage_flag), pred.xgb.prob)
